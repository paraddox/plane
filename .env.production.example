# Host binding for the single Plane entrypoint consumed by your external Caddy.
PLANE_BIND_HOST=127.0.0.1
PLANE_PORT=18130

# Public browser origin routed by external Caddy. Do not include a trailing slash.
PLANE_PUBLIC_URL=https://plane.example.com
CORS_ALLOWED_ORIGINS=https://plane.example.com

# Compose project name. Change this if you run multiple Plane prod stacks.
PLANE_COMPOSE_PROJECT=plane-prod

# Application secrets. Replace every value before deploying.
SECRET_KEY=change-me-generate-a-long-random-string
LIVE_SERVER_SECRET_KEY=change-me-generate-a-long-random-string

# PostgreSQL credentials and application database URL inside the Docker network.
POSTGRES_USER=plane
POSTGRES_PASSWORD=change-me
POSTGRES_DB=plane
DATABASE_URL=postgresql://plane:change-me@plane-db:5432/plane

# RabbitMQ credentials.
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=plane

# Local MinIO object storage.
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=change-me
AWS_S3_BUCKET_NAME=uploads

# Runtime behavior.
GUNICORN_WORKERS=2
FILE_SIZE_LIMIT=5242880
SIGNED_URL_EXPIRATION=3600
HARD_DELETE_AFTER_DAYS=60
API_KEY_RATE_LIMIT=60/minute
TRUSTED_PROXIES=0.0.0.0/0
